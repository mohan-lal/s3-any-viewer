{
  "name": "s3-any-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that opens any S3 object in a rich in-browser viewer (CSV, JSON, Parquet, XLSX, XML, images, PDF and more) instead of downloading it. No AWS keys required.",
  "license": "MIT",
  "author": "Mohanlal",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohan-lal/s3-any-viewer.git"
  },
  "bugs": "https://github.com/mohan-lal/s3-any-viewer/issues",
  "homepage": "https://github.com/mohan-lal/s3-any-viewer#readme",
  "keywords": [
    "chrome-extension",
    "aws",
    "s3",
    "viewer",
    "csv",
    "json",
    "parquet",
    "xlsx",
    "manifest-v3"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "fixtures": "node scripts/make-fixtures.mjs",
    "serve": "node scripts/serve.mjs",
    "package": "node scripts/package.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('release',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "hyparquet-writer": "^0.16.0",
    "puppeteer-core": "^25.11.0"
  },
  "dependencies": {
    "apache-arrow": "^18.0.0",
    "dompurify": "^3.2.0",
    "fflate": "^0.8.2",
    "highlight.js": "^11.11.0",
    "hyparquet": "^1.8.0",
    "hyparquet-compressors": "^1.1.0",
    "js-yaml": "^4.1.0",
    "marked": "^15.0.0",
    "papaparse": "^5.5.0",
    "smol-toml": "^1.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
